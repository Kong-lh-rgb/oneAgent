# 模型配置请按实际使用的 Provider 填写，真实密钥只放在 backend/.env。
MODEL_DEFAULT_PROVIDER=qwen
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus

# 网页搜索：auto 在存在 TAVILY_API_KEY 时使用 Tavily，否则使用 DuckDuckGo。
# 也可显式设置为 tavily 或 duckduckgo。
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=5

# 长期记忆：Sparse, file-backed, model-directed。不使用 SQLite / Embedding。
# 记忆文件位于 .oneagent/memory/（CORE.md、INDEX.md、active/、archive/）。

# 上下文预算：达到触发比例时标记需要压缩，超过输入预算时阻止模型请求。
CONTEXT_SAFETY_MARGIN_TOKENS=4096
CONTEXT_TRIGGER_RATIO=0.80
CONTEXT_TARGET_RATIO=0.60
# 仅达到压缩触发线后启用：保护最近 N 轮历史工具协议，并缩短更旧的长结果。
CONTEXT_KEEP_RECENT_TOOL_ROUNDS=2
CONTEXT_KEEP_RECENT_CONVERSATION_BLOCKS=4
CONTEXT_SUMMARY_MAX_OUTPUT_TOKENS=1024
CONTEXT_MAX_TOOL_RESULT_CHARS=8000
CONTEXT_TOOL_RESULT_HEAD_CHARS=4000
CONTEXT_TOOL_RESULT_TAIL_CHARS=2000

# 可选：覆盖某个具体模型的能力数据。
# CONTEXT_OVERRIDE_PROVIDER=qwen
# CONTEXT_OVERRIDE_MODEL=qwen3.7-plus
# CONTEXT_WINDOW_OVERRIDE=1000000
# MAX_OUTPUT_TOKENS_OVERRIDE=65536
